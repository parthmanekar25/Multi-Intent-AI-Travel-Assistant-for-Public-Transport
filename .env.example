# Groq API key for intent extraction and optional NL polish
GROQ_API_KEY=your_groq_api_key_here

# LTA DataMall AccountKey (https://datamall.lta.gov.sg)
LTA_API_KEY=your_lta_account_key_here

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
CACHE_TTL_SECONDS=60
BUS_SERVICES_CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=10
